{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Aura",
  "scopeName": "source.aura",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.aura",
          "match": "//.*$"
        },
        {
          "name": "comment.block.aura",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.aura",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.aura",
          "match": "\\\\(n|t|r|0|\\\\|\"|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})"
        },
        {
          "name": "invalid.illegal.escape.aura",
          "match": "\\\\."
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.aura",
          "match": "\\b(if|else|match|while|loop|break|continue|return)\\b"
        },
        {
          "name": "keyword.declaration.aura",
          "match": "\\b(fn|let|mut|struct|enum|use|extern)\\b"
        },
        {
          "name": "keyword.unsafe.aura",
          "match": "\\bunsafe\\b"
        },
        {
          "name": "constant.language.aura",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "variable.language.aura",
          "match": "\\b(Ok|Err)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.aura",
          "match": "\\b(i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|f32|f64|bool|str)\\b"
        },
        {
          "name": "support.type.result.aura",
          "match": "\\bResult\\b"
        },
        {
          "name": "entity.name.type.aura",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.aura",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.aura",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.aura",
          "match": "\\b0o[0-7_]+\\b"
        },
        {
          "name": "constant.numeric.float.aura",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.integer.aura",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.aura",
          "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.declaration.aura",
          "match": "(?<=fn\\s)[a-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.aura",
          "match": "(->|=>|\\?|==|!=|<=|>=|&&|\\|\\||[-+*/%<>=!&|?:@])"
        }
      ]
    }
  }
}
