// 26-log — build log lines in memory, write once, read back + count.
fn main() -> i64 {
    let mut log = ""
    let mut i = 0
    while i < 50 {
        log = log + "line " + str_from_int(i) + "\n"
        i = i + 1
    }
    if !write_file("app.log", log) { return 1 }
    match read_file("app.log") {
        Ok(c) => {
            if c != log { return 2 }
            // count newlines
            let mut n = 0
            let mut j = 0
            while j < c.len {
                if str_get(c, j) == 10 { n = n + 1 }
                j = j + 1
            }
            if n != 50 { return 3 }
        },
        Err(e) => exit(4),
    }
    println("log ok")
    return 0
}
