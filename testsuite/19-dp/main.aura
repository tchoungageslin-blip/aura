// 19-dp — coin change: min coins for amount 63 with {1,5,10,25} = 6.
fn min(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

fn main() -> i64 {
    let coins = vec_new()
    vec_push(coins, 1)
    vec_push(coins, 5)
    vec_push(coins, 10)
    vec_push(coins, 25)
    let amount = 63
    let dp = vec_new()
    let mut i = 0
    while i <= amount {
        vec_push(dp, 9999)
        i = i + 1
    }
    vec_set(dp, 0, 0)
    i = 1
    while i <= amount {
        let mut j = 0
        while j < coins.len {
            let c = vec_get(coins, j)
            if i >= c {
                vec_set(dp, i, min(vec_get(dp, i), vec_get(dp, i - c) + 1))
            }
            j = j + 1
        }
        i = i + 1
    }
    if vec_get(dp, 63) != 6 { return 1 }
    if vec_get(dp, 41) != 4 { return 2 }
    println("dp ok")
    return 0
}
