// 37-sci-stats — mean/variance/stddev over 10k LCG values + min/max.
fn main() -> i64 {
    let v = vec_new()
    let mut s = 12345
    let mut i = 0
    while i < 10000 {
        s = (s * 48271 + 11) % 2147483647
        vec_push(v, s % 1000)
        i = i + 1
    }
    // mean + population variance
    let mut sum = 0
    let mut j = 0
    while j < v.len {
        sum = sum + vec_get(v, j)
        j = j + 1
    }
    let mean = f64_from_int(sum) / f64_from_int(v.len)
    let mut sq = 0.0
    let mut k = 0
    while k < v.len {
        let d = f64_from_int(vec_get(v, k)) - mean
        sq = sq + d * d
        k = k + 1
    }
    let var = sq / f64_from_int(v.len)
    // min/max
    let mut lo = vec_get(v, 0)
    let mut hi = vec_get(v, 0)
    let mut m = 1
    while m < v.len {
        let x = vec_get(v, m)
        if x < lo { lo = x }
        if x > hi { hi = x }
        m = m + 1
    }
    println(str_from_f64(mean))
    println(str_from_f64(var))
    println(str_from_f64(sqrt(var)))
    println(str_from_int(lo))
    println(str_from_int(hi))
    println("stats ok")
    return 0
}
