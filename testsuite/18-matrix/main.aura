// 18-matrix — 3x3 matrix multiply, flat vec<i64> row-major.
fn at(m: vec<i64>, r: usize, c: usize) -> i64 {
    vec_get(m, r * 3 + c)
}

fn main() -> i64 {
    let a = vec_new()
    let b = vec_new()
    let c = vec_new()
    // a = 1..9 row-major; b = identity*2 + row mix
    let mut i = 0
    while i < 9 {
        vec_push(a, i + 1)
        vec_push(b, (i + 1) * 2)
        vec_push(c, 0)
        i = i + 1
    }
    // c = a * b
    let mut r = 0
    while r < 3 {
        let mut k = 0
        while k < 3 {
            let mut s = 0
            let mut j = 0
            while j < 3 {
                s = s + at(a, r, j) * at(b, j, k)
                j = j + 1
            }
            vec_set(c, r * 3 + k, s)
            k = k + 1
        }
        r = r + 1
    }
    // b = 2*a (elem), so c = 2*a² — check a few entries:
    // a² row0: 1*1+2*4+3*7=30, 1*2+2*5+3*8=36, 1*3+2*6+3*9=42
    if vec_get(c, 0) != 60 { return 1 }
    if vec_get(c, 1) != 72 { return 2 }
    if vec_get(c, 2) != 84 { return 3 }
    // a² row2: 7*1+8*4+9*7=102 ... *2 = 204
    if vec_get(c, 6) != 204 { return 4 }
    println("matrix ok")
    return 0
}
