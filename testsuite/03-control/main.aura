// 03-control — if-as-value, while/loop, break/continue, nesting.
fn main() -> i64 {
    // if as a value requires else
    let s = if 3 > 2 { 10 } else { 20 }
    if s != 10 { return 1 }
    // while + break/continue
    let mut i = 0
    let mut sum = 0
    while i < 10 {
        i = i + 1
        if i % 2 == 0 { continue }
        if i > 9 { break }
        sum = sum + i
    }
    if sum != 25 { return 2 }     // 1+3+5+7+9
    // loop + break
    let mut n = 0
    loop {
        n = n + 1
        if n >= 5 { break }
    }
    if n != 5 { return 3 }
    // nested loops with inner break
    let mut count = 0
    let mut a = 0
    while a < 4 {
        let mut b = 0
        while b < 4 {
            if b == 2 { break }
            count = count + 1
            b = b + 1
        }
        a = a + 1
    }
    if count != 8 { return 4 }
    // else-if chain as value
    let g = if s < 5 { 1 } else if s < 15 { 2 } else { 3 }
    if g != 2 { return 5 }
    println("control ok")
    0
}
