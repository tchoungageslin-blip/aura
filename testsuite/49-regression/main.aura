// 49-regression — every bug the suite has caught, exercised together.
// If any regresses, this fails before the fix's own test even runs.

struct Pair { a: i64, b: str }

fn div(a: i64, b: i64) -> Result<i64, str> {
    if b == 0 { return Err("div0") }
    Ok(a / b)
}

fn main() -> i64 {
    // else-if chains without terminal else (was E2101 on unit tails)
    let mut grade = 0
    let score = 85
    if score >= 90 {
        grade = 1
    } else if score >= 80 {
        grade = 2
    } else if score >= 70 {
        grade = 3
    }
    if grade != 2 { return 1 }

    // struct field assign through a path (was interp-unsupported)
    let mut p = Pair { a: 1, b: "x" }
    p.a = 41
    p.b = "y"
    if p.a != 41 || p.b != "y" { return 2 }

    // vec_pop + vec_get mixed indexing (usize indexes)
    let v = vec_new()
    vec_push(v, 10)
    vec_push(v, 20)
    vec_push(v, 30)
    if vec_pop(v) != 30 { return 3 }
    if v.len != 2 { return 4 }

    // str byte ops: get + slice + from_byte round-trip
    let s = "hello"
    if str_get(s, 0) != 104 { return 5 }
    if str_slice(s, 1, 3) != "el" { return 6 }
    if str_from_byte(str_get(s, 0)) != "h" { return 7 }

    // i128 arithmetic (was iconst.i128 unsupported)
    let big: i128 = 34028236692093846346337460743176821145
    let big2: i128 = big + big
    if big2 != 68056473384187692692674921486353642290 { return 8 }

    // str_from_int over non-i64 widths (usize len)
    if str_from_int(s.len) != "5" { return 9 }

    // Result + ? propagation
    match div(10, 2) {
        Ok(q) => {
            if q != 5 { return 10 }
        },
        Err(e) => exit(11),
    }
    match div(1, 0) {
        Ok(q) => exit(12),
        Err(e) => {
            if e != "div0" { return 13 }
        },
    }

    // file round-trip inside the scenario workdir
    if !write_file("regr.tmp", "persist") { return 14 }
    match read_file("regr.tmp") {
        Ok(c) => {
            if c != "persist" { return 15 }
        },
        Err(e) => exit(16),
    }

    println("regression ok")
    return 0
}
