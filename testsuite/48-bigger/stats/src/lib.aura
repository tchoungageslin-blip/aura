// stats — summary statistics over vec<i64>.
fn sum(v: vec<i64>) -> i64 {
    let mut t = 0
    let mut i = 0
    while i < v.len {
        t = t + vec_get(v, i)
        i = i + 1
    }
    t
}
fn mean100(v: vec<i64>) -> i64 {
    // mean * 100 (integer math keeps it deterministic); n counts in
    // i64 since v.len is usize and there's no int->int cast yet.
    let mut n = 0
    let mut i = 0
    while i < v.len {
        n = n + 1
        i = i + 1
    }
    sum(v) * 100 / n
}
fn vmax(v: vec<i64>) -> i64 {
    let mut m = vec_get(v, 0)
    let mut i = 1
    while i < v.len {
        let x = vec_get(v, i)
        if x > m { m = x }
        i = i + 1
    }
    m
}
