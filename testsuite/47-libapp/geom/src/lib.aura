// geom — types + fns crossing the package boundary.
struct Point { x: i64, y: i64 }
enum Shape { Circle(i64), Rect(i64, i64), Dot }

fn area2(s: Shape) -> i64 {
    // 2*area avoids floats: circle -> 2*r*r (no pi)
    match s {
        Circle(r) => 2 * r * r,
        Rect(w, h) => 2 * w * h,
        Dot => 0,
    }
}

fn dist2(a: Point, b: Point) -> i64 {
    let dx = a.x - b.x
    let dy = a.y - b.y
    dx * dx + dy * dy
}
