// 42-cli — wc-style tool: stdin bytes -> lines/words/chars counts,
// mode selected by argv[1].
fn main() -> i64 {
    let a = args()
    if a.len < 2 { return 1 }
    let mode = vec_get(a, 1)
    let inp = read_stdin()
    let mut lines = 0
    let mut words = 0
    let mut in_word = false
    let mut i = 0
    while i < inp.len {
        let b = str_get(inp, i)
        if b == 10 { lines = lines + 1 }
        if b == 32 || b == 9 || b == 10 || b == 13 {
            in_word = false
        } else if !in_word {
            in_word = true
            words = words + 1
        }
        i = i + 1
    }
    let out = if mode == "lines" {
        str_from_int(lines)
    } else if mode == "words" {
        str_from_int(words)
    } else if mode == "chars" {
        str_from_int(inp.len)
    } else {
        "bad mode"
    }
    println(out)
    println("cli ok")
    return 0
}
