// 20-recursion — ackermann + mutual recursion + deep fib.
fn ack(m: i64, n: i64) -> i64 {
    if m == 0 { return n + 1 }
    if n == 0 { return ack(m - 1, 1) }
    ack(m - 1, ack(m, n - 1))
}

fn is_even(n: i64) -> bool {
    if n == 0 { return true }
    is_odd(n - 1)
}

fn is_odd(n: i64) -> bool {
    if n == 0 { return false }
    is_even(n - 1)
}

fn fib(n: i64) -> i64 {
    if n < 2 { return n }
    fib(n - 1) + fib(n - 2)
}

fn main() -> i64 {
    if ack(2, 3) != 9 { return 1 }
    if ack(1, 10) != 12 { return 2 }
    if !is_even(100) { return 3 }
    if !is_odd(77) { return 4 }
    if fib(15) != 610 { return 5 }
    println("recursion ok")
    return 0
}
